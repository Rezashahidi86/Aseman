NODE_ENV=development
PORT=3000
DATABASE_URL=mongodb://127.0.0.1:27017/aseman
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
SMS_API_KEY=
SMS_SENDER=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Docker MongoDB credentials (replace with independent strong random secrets)
MONGO_ROOT_USERNAME=aseman_root
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=aseman_app
MONGO_APP_PASSWORD=
MONGO_REPLICA_SET_KEY=

# Automatic MongoDB backup encryption (generate a separate random 32-byte secret)
BACKUP_ENCRYPTION_KEY=

# send email
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://127.0.0.1:8080
# Docker host ports
MONGO_HOST_PORT=27018
APP_HOST_PORT=8080
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
