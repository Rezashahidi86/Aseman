
{
  "name": "project-asman",
  "version": "1.0.0",
  "private": true,
  "description": "Aseman - Multi-branch shop management application",
  "type": "module",
  "main": "backend/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",

    "lint": "eslint backend",
    "lint:fix": "eslint backend --fix",

    "test": "vitest run --root backend",
    "test:watch": "vitest --root backend",

    "build": "npm run build:frontend",
    "build:frontend": "vite build --config frontend/vite.config.js frontend",
    "preview:frontend": "vite preview --config frontend/vite.config.js",

    "dev:frontend": "vite --config frontend/vite.config.js frontend",

    "seed:branches": "node backend/scripts/seedBranches.js",
    "seed:admin": "node backend/scripts/seedAdmin.js",

    "migrate:drop-product-name-unique-index": "node backend/scripts/dropProductNameUniqueIndex.js",
    "migrate:product-name-index": "node backend/scripts/migrateProductNameIndex.js",
    "migrate:reference-catalog-barcode-index": "node backend/scripts/migrateReferenceCatalogBarcodeIndex.js",
    "migrate:product-barcode-index": "node backend/scripts/migrateProductBarcodeIndex.js",

    "rebuild:sales-stats": "node backend/scripts/rebuildSalesStats.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Rezashahidi86/Aseman.git"
  },
  "bugs": {
    "url": "https://github.com/Rezashahidi86/Aseman/issues"
  },
  "homepage": "https://github.com/Rezashahidi86/Aseman",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "kavenegar": "^1.1.4",
    "mongoose": "^9.11.4",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@vitejs/plugin-react": "^5.1.1",
    "axios": "^1.12.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.9.4",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.17",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
